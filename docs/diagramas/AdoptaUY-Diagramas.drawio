        <mxCell id="s9_32" value="10: sub (Google_ID), email verificado, nombre y apellido" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;fontFamily=Arial;fontColor=#222222;fontSize=12;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="671.5" y="614" width="387" height="15" as="geometry" /></mxCell>
