2b1e25;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="db" target="dbdata"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="copia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#6b5a63;strokeWidth=1.5;fontSize=11;fontColor=#2b1e25;labelBackgroundColor=#ffffff;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="backup" target="dbdata"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota" value="Decisiones aplicadas: D55 (OpenStreetMap + Leaflet), D73 (HTTPS autofirmado), D76 (respaldo diario) y D77 (NAT de VirtualBox). El correo no pasa por un servidor propio: el mailer de Laravel lo envía directo al proveedor SMTP externo; en desarrollo lo captura Mailpit. Pendiente: elegir el proveedor SMTP (Gmail o Brevo)." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#6b5a63;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1700" height="50" as="geometry" /></mxCell><mxCell id="leyenda" value="Línea continua: ruta de comunicación con protocolo y puerto. Línea discontinua: dependencia (uso de volumen o artefacto). Cubos: nodos (dispositivos y entornos de ejecución); hoja con esquina: artefacto." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#6b5a63;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1700" height="30" as="geometry" /></mxCell><mxCell id="google" value="&lt;i&gt;«servicio externo»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Google OAuth 2.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b5a63&quot;&gt;Google Cloud · Continuar con Google (RF:0066)&lt;br&gt;client secret solo en el .env del servidor&lt;/font&gt;" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f4f0f2;strokeColor=#6b5a63;fontColor=#2b1e25;fontSize=13;strokeWidth=1.5;dashed=1;direction=south;" vertex="1" parent="1"><mxGeometry x="1810" y="620" width="280" height="135" as="geometry" /></mxCell>
<mxCell id="e_google" value="HTTPS :443 · OAuth 2.0 (Socialite)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#2b1e25;strokeWidth=2;fontSize=11;fontColor=#2b1e25;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="google"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1047.5" y="345" /><mxPoint x="1770" y="345" /><mxPoint x="1770" y="687.5" /></Array></mxGeometry></mxCell>
