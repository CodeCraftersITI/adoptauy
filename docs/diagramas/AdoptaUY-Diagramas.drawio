avel 13)&lt;/font&gt;" style="shape=cube;size=10;direction=south;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8d7e3;strokeColor=#b03a69;fontColor=#2b1e25;fontSize=13;strokeWidth=1.5;" vertex="1" parent="docker"><mxGeometry x="330" y="85" width="230" height="135" as="geometry" /></mxCell><mxCell id="queue" value="&lt;i&gt;«container»&lt;/i&gt;&lt;br&gt;&lt;b&gt;queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b5a63&quot;&gt;php:8.4-fpm · queue:work · envío de correos con el mailer de Laravel&lt;/font&gt;" style="shape=cube;size=10;direction=south;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8d7e3;strokeColor=#b03a69;fontColor=#2b1e25;fontSize=13;strokeWidth=1.5;" vertex="1" parent="docker"><mxGeometry x="645" y="85" width="220" height="135" as="geometry" /></mxCell><mxCell id="storage" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;storage/app/public&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b5a63&quot;&gt;fotos de publicaciones, evidencias y documentos de refugios&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#6b5a63;fontColor=#2b1e25;fontSize=13;strokeWidth=1.5;" vertex="1" parent="docker"><mxGeometry x="25" y="305" width="230" height="115" as="geometry" /></mxCell><mxCell id="db" value="&lt;i&gt;«container»&lt;/i&gt;&lt;br&gt;&lt;b&gt;db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b5a63&quot;&gt;mysql:8.4 · «artifact» esquema adoptauy (utf8mb4)&lt;/font&gt;" style="shape=cube;size=10;direction=south;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8d7e3;strokeColor=#b03a69;fontColor=#2b1e25;fontSize=13;strokeWidth=1.5;