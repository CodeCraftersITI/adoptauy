        <mxCell id="s9_34" value="11: SELECT … FROM Usuario WHERE Google_ID = ?" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;fontFamily=Arial;fontColor=#222222;fontSize=12;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="853.5" y="651" width="313" height="15" as="geometry" /></mxCell>
