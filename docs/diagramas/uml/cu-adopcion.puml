@startuml cu-adopcion
!include _estilo.iuml
left to right direction
title Casos de uso: adopción y seguimiento
actor "Particular\n(solicitante / adoptante)" as PA
actor "Publicante\n(Particular o Refugio)" as P
actor "Planificador\n(tareas programadas, 03:00)" as S <<sistema>>
actor "Sistema de correo" as M <<sistema>>
rectangle AdoptaUY {
  usecase "Solicitar adopción\nRF:0049" as UC49
  usecase "Aceptar compartir nombre,\nteléfono y correo" as UCC
  usecase "Consultar solicitudes enviadas\nRF:0054" as UC54
  usecase "Consultar solicitudes recibidas\nRF:0050" as UC50
  usecase "Rechazar solicitud\nRF:0051" as UC51
  usecase "Concretar adopción\nRF:0052" as UC52
  usecase "Rechazar solicitudes restantes" as UCR
  usecase "Enviar aviso de seguimiento\n(día 15) RF:0055" as UC55
  usecase "Enviar fotografía de seguimiento\nRF:0056" as UC56
  usecase "Revisar fotografía\nRF:0057" as UC57
  usecase "Restringir cuenta\n(día 22 sin fotografía)\nRF:0058" as UC58
  usecase "Notificar por correo\nRF:0063" as UC63
}
PA --> UC49
PA --> UC54
PA --> UC56
P --> UC50
P --> UC51
P --> UC52
P --> UC57
S --> UC55
S --> UC58
UC49 ..> UCC : <<include>>
UC49 ..> UC63 : <<include>>
UC52 ..> UCR : <<include>>
UC55 ..> UC63 : <<include>>
UC63 --> M
@enduml
