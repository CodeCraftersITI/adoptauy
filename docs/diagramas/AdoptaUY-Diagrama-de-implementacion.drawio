/><mxPoint x="837.0" y="647.5"/></Array></mxGeometry></mxCell><mxCell id="e15" value="sirve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#6b5a63;strokeWidth=1.5;fontSize=11;fontColor=#2b1e25;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="web" target="storage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="persiste" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#6b5a63;strokeWidth=1.5;fontSize=11;fontColor=#2b1e25;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="db" target="dbdata"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="copia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#6b5a63;strokeWidth=1.5;fontSize=11;fontColor=#2b1e25;labelBackgroundColor=#ffffff;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="backup" target="dbdata"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nota" value="Decisiones aplicadas: D54 (Postfix relay), D55 (OpenStreetMap + Leaflet), D73 (HTTPS autofirmado), D75 (Postfix en contenedor), D76 (respaldo diario) y D77 (NAT de VirtualBox). Pendiente: proveedor del SMTP externo y correspondencia con los servidores de la sección 16 (SRV-WEB, SRV-BD, SRV-MAIL, SRV-ZABBIX), a definir con el docente." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#6b5a63;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1700" height="50" as="geometry"/></mxCell><mxCell id="leyenda" value="Línea continua: ruta de comunicación con protocolo y puerto. Línea discontinua: dependencia (uso de volumen o artefacto). Cubos: nodos (dispositivos y entornos de ejecución); hoja con esquina: artefacto." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#6b5a63;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>