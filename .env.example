# Variables opcionales de docker-compose. Sin .env se usan los valores por defecto (sirven para desarrollar).
# En el servidor local: copiar a .env, cambiar las contraseñas y NUNCA subir el .env.

# Base de datos
DB_DATABASE=adoptauy
DB_USERNAME=adoptauy
DB_PASSWORD=adoptauy_dev
DB_ROOT_PASSWORD=root_dev

# Inicio de sesión y registro con usuarios de MySQL de privilegio mínimo (16.3.4, RNF:0007).
# Se crean con docs/base-de-datos/usuarios.sql (cambiando antes sus contraseñas):
#   docker compose exec -T db mysql -uroot -p"$DB_ROOT_PASSWORD" --default-character-set=utf8mb4 < docs/base-de-datos/usuarios.sql
# Sin estas variables, el login y el registro usan DB_USERNAME.
# DB_LOGIN_USERNAME=adoptauy_login
# DB_LOGIN_PASSWORD=
# DB_PUBLICO_USERNAME=adoptauy_publico
# DB_PUBLICO_PASSWORD=

# Puertos en tu máquina (cambialos si alguno está ocupado)
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT_LOCAL=3307
MAILPIT_PORT=8025

# URL con la que entrás al sitio (con el puerto HTTPS)
APP_URL=https://localhost:8443

# Tu usuario (Linux/WSL: id -u / id -g) para que los archivos no queden como root
UID=1000
GID=1000

# Producción: Laravel envía directo al SMTP del proveedor externo, por el 587 con STARTTLS.
# La contraseña de aplicación del proveedor va solo en el .env del servidor.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply.adoptauy@gmail.com
# MAIL_PASSWORD=<contraseña de aplicación de 16 letras, sin espacios>
# MAIL_FROM_ADDRESS=noreply.adoptauy@gmail.com
