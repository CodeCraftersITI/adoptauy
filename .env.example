# Variables de docker-compose. Copiar a .env (lo hace scripts/iniciar.sh) y NUNCA subir el .env.

# Base de datos
DB_DATABASE=adoptauy
DB_USERNAME=adoptauy
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_otra_clave

# Puertos en tu máquina (cambialos si alguno está ocupado)
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT_LOCAL=3307
MAILPIT_PORT=8025

# URL con la que entrás al sitio (incluí el puerto si no es 443)
APP_URL=https://localhost

# Tu usuario (Linux/WSL: id -u / id -g) para que los archivos no queden como root
UID=1000
GID=1000

# Producción (perfil "produccion"): relay SMTP externo
# MAIL_HOST=mail
# MAIL_PORT=587
# SMTP_RELAY_HOST=
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=
# MAIL_SENDER_DOMAIN=
