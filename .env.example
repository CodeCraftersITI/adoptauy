# Variables opcionales de docker-compose. Sin .env se usan los valores por defecto (sirven para desarrollar).
# En el servidor local: copiar a .env, cambiar las contraseñas y NUNCA subir el .env.

# Base de datos
DB_DATABASE=adoptauy
DB_USERNAME=adoptauy
DB_PASSWORD=adoptauy_dev
DB_ROOT_PASSWORD=root_dev

# Puertos en tu máquina (cambialos si alguno está ocupado)
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT_LOCAL=3307
MAILPIT_PORT=8025

# URL con la que entrás al sitio (con el puerto HTTPS)
APP_URL=https://localhost:8443

# Tu usuario (Linux/WSL: id -u / id -g) para que los archivos no queden como root
UID=1000
GID=1000

# Producción (perfil "produccion"): relay SMTP externo
# MAIL_HOST=mail
# MAIL_PORT=587
# SMTP_RELAY_HOST=
# SMTP_RELAY_USER=
# SMTP_RELAY_PASSWORD=
# MAIL_SENDER_DOMAIN=
