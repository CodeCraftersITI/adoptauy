<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuración de las pruebas funcionales con Dusk (php artisan dusk).
    Fuerza la base adoptauy_test: Docker define DB_DATABASE=adoptauy y "force" la pisa.
    DuskTestCase además se niega a correr si la conexión no es adoptauy_test.
    DUSK_URL y DUSK_DRIVER_URL apuntan a los contenedores de Docker; en GitHub Actions las pisa el workflow.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="adoptauy_test" force="true"/>
        <server name="MAIL_MAILER" value="log" force="true"/>
        <env name="DUSK_URL" value="http://pruebas-web:8000"/>
        <env name="DUSK_DRIVER_URL" value="http://selenium:4444/wd/hub"/>
    </php>
</phpunit>
